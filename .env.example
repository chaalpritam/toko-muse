# Meta Model API (https://dev.meta.ai) — Muse Spark, Muse Image, SAM 3.1, Muse Voice Transcribe
MODEL_API_KEY=
# Optional overrides
# MUSE_SPARK_MODEL=muse-spark-1.3
# MUSE_IMAGE_MODEL=muse-image-1.0
# SAM_MODEL=sam-3.1
# ASR_MODEL=muse-voice-transcribe-1.0

# Stripe test mode (https://dashboard.stripe.com/test/apikeys). Without it, online orders are pay-at-pickup.
STRIPE_SECRET_KEY=sk_test_...

# WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api). Optional: without these,
# WhatsApp is simulated and /whatsapp plays the customer's phone. The webhook is /api/whatsapp/webhook.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=any-string-you-pick
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0

# Café
NEXT_PUBLIC_CURRENCY=usd
# Where phones reach the store when they scan the device's QR code (a tunnel or LAN address).
# Defaults to the address the device page is open on.
# NEXT_PUBLIC_STORE_ORIGIN=https://your-tunnel.example
# Average seconds between orders from each simulated delivery app once connected.
# DELIVERY_EVERY_SECONDS=90

# Landing page: link to the demo video (hidden until set).
# NEXT_PUBLIC_DEMO_VIDEO_URL=
